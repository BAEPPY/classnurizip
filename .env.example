# Optional. When empty, the server creates a random class code in .data/class-code.txt.
CLASS_CODE=
CLASS_NAME=우리 반
HOST=127.0.0.1
PORT=3000
# Set to true when serving the application over HTTPS.
COOKIE_SECURE=false
# Vercel: connect a Neon database and set DATABASE_URL and CLASS_CODE in project settings.
# Locally, an empty DATABASE_URL uses persistent embedded PostgreSQL in .data/postgres.
DATABASE_URL=
